{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./backend/target/**)",
      "Read(./frontend/node_modules/**)",
      "Read(./frontend/.angular/**)",
      "Read(./frontend/dist/**)",
      "Read(./frontend/coverage/**)",
      "Read(./**/.idea/**)",
      "Read(./**/*.log)",
      "Read(./.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./frontend/src/app/core/api/generated/**)"
    ],
    "ask": [
      "Edit(./backend/src/main/resources/db/migration/**)",
      "Edit(./scripts/**)"
    ]
  }
}
